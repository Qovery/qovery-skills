# Qovery API
QOVERY_API_TOKEN=your-qovery-api-token

# SSO Configuration
SSO_PROVIDER=google                          # google, okta, azure, oidc
SSO_CLIENT_ID=your-sso-client-id
SSO_CLIENT_SECRET=your-sso-client-secret
SSO_ISSUER_URL=https://accounts.google.com   # Only needed for OIDC/Okta/Azure

# Portal
PORTAL_URL=https://builder.company.com       # Public URL of this portal
SESSION_SECRET=random-secret-string-change-me

# Branding
COMPANY_NAME=Your Company
COMPANY_LOGO_URL=https://example.com/logo.svg
PRIMARY_COLOR=#2563EB

# Limits
MAX_ENVIRONMENTS_PER_BUILDER=3

# Config
BUILDER_PLATFORM_CONFIG_PATH=./builder-platform-config.yaml
